# Copy this to .env and add your own keys.
# ALL keys are optional. The tool works without them, just with fewer modules.
# Do NOT commit .env (it is already in .gitignore).

# HaveIBeenPwned (breach exposure check). https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# SpiderFoot: if sf.py is not on PATH, set the repo root here
SPIDERFOOT_PATH=

# Optional keys used by recon-ng / theHarvester modules
SHODAN_API_KEY=
HUNTER_API_KEY=
VIRUSTOTAL_API_KEY=
